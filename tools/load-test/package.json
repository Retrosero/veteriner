{
  "name": "@vetniva/load-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Performans ve yuk testi altyapisi (GOAL-122, FAZ-12). Kritik senaryolar icin k6 scriptleri + threshold/report motoru.",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "node --import tsx src/cli-validate.ts",
    "report": "node --import tsx src/cli-report.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
