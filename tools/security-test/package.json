{
  "name": "@vetniva/security-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OWASP ASVS L1-L3 temelli güvenlik test paketi (GOAL-123, FAZ-12). Kimlik doğrulama, yetkilendirme, IDOR, XSS, CSRF, SQL injection, dosya yükleme, rate limit, tenant izolasyonu senaryolari.",
  "main": "src/index.ts",
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "type-check": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "test": "vitest run",
    "run": "node --import tsx src/cli-run.ts",
    "report": "node --import tsx src/cli-report.ts",
    "validate": "node --import tsx src/cli-validate.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vetniva/config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
