{
  "name": "@vetniva/backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL yedekleme + restore test araclari (GOAL-124, FAZ-12). RPO/RTO tier destegi, AES-256 at-rest, retention policy.",
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "type-check": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "validate": "node --import tsx src/validate.ts",
    "dry-run": "node --import tsx src/dry-run.ts"
  },
  "devDependencies": {
    "@vetniva/config": "workspace:*",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
