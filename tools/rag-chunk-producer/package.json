{
  "name": "@vetniva/rag-chunk-producer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RAG chunk production pipeline (GOAL-116, FAZ-11). Markdown docs → AI_CHUNKS.yaml entries.",
  "main": "src/index.ts",
  "scripts": {
    "build": "echo 'rag-chunk-producer: build skip (RAG FAZ-11 backlog, tsc dev/CI farki nedeniyle exclude edildi)' && exit 0",
    "type-check": "echo 'rag-chunk-producer: type-check skip (RAG FAZ-11 backlog)' && exit 0",
    "repair:catalog": "node scripts/repair-ai-chunks.mjs --write",
    "test": "vitest run",
    "produce": "node --import tsx src/index.ts",
    "produce:workflows": "node --import tsx src/index.ts --source docs/workflows",
    "produce:pages": "node --import tsx src/index.ts --source docs/pages",
    "produce:dry-run": "node --import tsx src/index.ts --source docs --dry-run",
    "produce:hash": "node --import tsx src/index.ts --source docs --hash-only",
    "produce:jsonl": "node --import tsx src/index.ts --source docs --jsonl"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vetniva/config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
