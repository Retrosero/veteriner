{
  "name": "@vetniva/rag-chunk-producer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RAG chunk production pipeline (GOAL-116, FAZ-11). Markdown docs → AI_CHUNKS.yaml entries.",
  "main": "src/index.ts",
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "type-check": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "repair:catalog": "node scripts/repair-ai-chunks.mjs --write",
    "test": "vitest run",
    "produce": "node --import tsx src/index.ts",
    "produce:workflows": "node --import tsx src/index.ts --source docs/workflows",
    "produce:pages": "node --import tsx src/index.ts --source docs/pages"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@vetniva/config": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
