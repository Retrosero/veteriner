{
  "name": "@vetniva/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "VetNiva çoklu dil altyapısı: i18next config + tr-TR / en-GB kaynak dosyaları.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tr-TR": "./src/locales/tr-TR.json",
    "./en-GB": "./src/locales/en-GB.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "dev": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings=0",
    "type-check": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@vetniva/contracts": "workspace:*",
    "i18next": "^24.0.5",
    "react-i18next": "^15.1.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vetniva/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
