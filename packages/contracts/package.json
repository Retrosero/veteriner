{
  "name": "@vetniva/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "VetNiva paylaşılan sözleşmeler: Zod şemaları + türetilmiş tipler. API ile frontend arasındaki tek doğruluk kaynağı.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "dev": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --watch",
    "lint": "eslint src --max-warnings=0",
    "type-check": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@vetniva/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
