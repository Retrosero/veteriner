{
  "name": "@vetniva/config",
  "version": "0.1.0",
  "private": true,
  "description": "VetNiva ortak konfigürasyon presetleri: tsconfig, eslint, prettier, tailwind.",
  "type": "module",
  "main": "./index.js",
  "exports": {
