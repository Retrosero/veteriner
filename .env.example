# =============================================================
# VetNiva — environment variables (example)
# Copy to .env and fill values. NEVER commit .env.
# =============================================================

# ---- General ----
NODE_ENV=development
APP_VERSION=0.1.0
APP_NAME=vetniva
LOG_LEVEL=info
PORT_API=3001
PORT_WEB=3000
PORT_WORKER=3002
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
DEFAULT_LOCALE=tr-TR
SUPPORTED_LOCALES=tr-TR,en-GB

# ---- Database (PostgreSQL via Docker) ----
DATABASE_URL=postgresql://vetniva:vetniva@localhost:5432/vetniva?schema=public
DATABASE_SHADOW_URL=postgresql://vetniva:vetniva@localhost:5432/vetniva_shadow?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ---- Auth (GOAL-001) ----
AUTH_JWT_SECRET=replace-me-min-32-chars-random
AUTH_JWT_ACCESS_TTL=900
AUTH_JWT_REFRESH_TTL=2592000
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_INVITE_TTL=86400

# ---- Object storage (GOAL-002) ----
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=eu-central-1

# ---- Email (dev uses Mailhog) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vetniva.local
SMTP_SECURE=false

# ---- Observability (Faz 10) ----
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
ERROR_REPORTING_SAMPLE_RATE=1.0

# ---- Feature flags ----
FEATURE_VACCINATION=false
FEATURE_PETSHOP=false
FEATURE_SURGERY=false
FEATURE_LAB=false
FEATURE_PORTAL=true
