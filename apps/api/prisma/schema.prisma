// GOAL-010 — Tenant ve şube veri modeli.
// GOAL-011 — Kimlik doğrulama ve oturum yönetimi (User, Session, Invitation,
// PasswordResetToken).
// GOAL-012 — RBAC ve izin motoru (User.isSuperadmin, UserSession.activeBranchId).
//
// Bu şema Faz 1 platform çekirdeğinin temelidir:
// - `tenants` kök tablosudur (multi-tenant kök).
// - `branches` tenant'a bağlı şubelerdir (pilot tek şube ile başlar).
// - `users` platform kullanıcılarıdır (parola, oturum, kilit, isSuperadmin).
// - `user_sessions` aktif oturumlardır (cookie token + aktif branch).
// - `user_invitations` tenant'a kullanıcı davetleridir.
// - `password_reset_tokens` parola sıfırlama token'larıdır.
// - `audit_events` append-only olay tablosudur (klinik/finansal kayıt
//   koruması).
// - `user_tenant_memberships` kullanıcı ↔ tenant ilişkisidir; bu goal
//   kapsamında `User` FK ile sıkılaştırılır.
//
// RLS (Row Level Security) migration dosyasında etkinleştirilir:
// apps/api/prisma/migrations/<timestamp>_init/migration.sql
//
// @see docs/domain/DOMAIN_GLOSSARY.md — tenant, branch, user varlık tanımları.
// @see docs/errors/AUDIT_LOG_STANDARD.md — audit event şeması.
// @see skills/DATABASE_MULTITENANCY.md — multi-tenant veri kuralları.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// TENANT — Kök tablo. Her tenant kendi tenant_id'si ile izole edilir.
// -----------------------------------------------------------------------------

/// Tenant durumu.
/// - `active`: normal operasyon.
/// - `suspended`: ödeme/operasyon nedeniyle geçici olarak devre dışı.
/// - `closed`: kapatılmış (fiziksel silme YOK; audit ve operasyonel
///   kayıtlar korunur).
enum TenantStatus {
  active
  suspended
  closed

  @@map("tenant_status")
}

/// Kök tenant tablosu. Her tenant benzersiz `slug` ile tanınır.
/// Tenant oluşturma yalnızca SUPERADMIN tarafından yapılır.
model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  /// URL-dostu benzersiz tanımlayıcı (örn. "pilot-vet-kadikoy").
  slug           String       @unique @db.VarChar(64)
  /// Görünen işletme adı.
  name           String       @db.VarChar(200)
  /// Tenant ülkesi (TR/GB). Tenant oluşturulduktan sonra değiştirilemez
  /// (ülke adaptörü seçimi bu alana göre yapılır).
  country        String       @db.Char(2)
  /// Tenant varsayılan dili.
  defaultLocale  String       @default("tr-TR") @map("default_locale") @db.VarChar(10)
  /// IANA saat dilimi (örn. Europe/Istanbul).
  timezone       String       @default("Europe/Istanbul") @db.VarChar(64)
  /// Tenant durumu.
  status         TenantStatus @default(active)
  /// Vergi/VKN numarası (opsiyonel).
  taxId          String?      @map("tax_id") @db.VarChar(20)
  /// VKN/TCKN sahip tipi (`company` veya `personal`).
  taxIdType      String?      @map("tax_id_type") @db.VarChar(20)
  /// İletişim e-posta (tenant düzeyinde).
  contactEmail   String?      @map("contact_email") @db.VarChar(200)
  /// Tenant oluşturulma zamanı.
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Son güncelleme zamanı.
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Kapatma/arsivleme zamanı (soft delete).
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  /// Kapatma sebebi (operasyonel not).
  archivedReason String?      @map("archived_reason") @db.VarChar(500)

  branches              Branch[]
  memberships           UserTenantMembership[]
  invitations           UserInvitation[]
  files                 FileMeta[]
  controlledDrugEntries ControlledDrugEntry[]

  @@index([status, createdAt])
  @@index([country])
  @@map("tenants")
}

// -----------------------------------------------------------------------------
// BRANCH — Tenant'ın fiziksel şubesi. Pilot tek şube ile başlar; veri
// modeli çoklu şubeye uygundur.
// -----------------------------------------------------------------------------

/// Şube durumu.
/// - `active`: aktif şube, operasyon yapılabilir.
/// - `inactive`: geçici olarak kapalı (tatil, tadilat).
/// - `closed`: kapatılmış (fiziksel silme YOK).
enum BranchStatus {
  active
  inactive
  closed

  @@map("branch_status")
}

/// Tenant şubesi. Her şube bir tenant'a aittir; tenant olmadan şube
/// oluşturulamaz (FK).
model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  /// Ait olduğu tenant.
  tenantId    String       @map("tenant_id") @db.Uuid
  /// Şube kodu (tenant içinde benzersiz; URL-dostu).
  code        String       @db.VarChar(64)
  /// Şube görünen adı.
  name        String       @db.VarChar(200)
  /// Şehir (operasyonel raporlama için).
  city        String?      @db.VarChar(100)
  /// Adres (JSON; ülke adaptörü ile formatlanır).
  addressJson Json?        @map("address_json")
  /// Şube telefonu.
  phone       String?      @db.VarChar(32)
  /// Şube durumu.
  status      BranchStatus @default(active)
  /// Şube oluşturulma zamanı.
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Son güncelleme zamanı.
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Kapatma/arsivleme zamanı.
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  files  FileMeta[]

  /// Tenant içinde şube kodu benzersizdir.
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([city])
  @@map("branches")
}

// -----------------------------------------------------------------------------
// USER_TENANT_MEMBERSHIP — Tenant-scoped kullanıcı üyeliği.
// GOAL-011 ile birlikte `User` FK bağlantısı kurulur; tenant kapsamında
// rol ataması bu tablo üzerinden yapılır.
// -----------------------------------------------------------------------------

/// Tenant üyelik durumu.
enum MembershipStatus {
  active
  suspended
  revoked

  @@map("membership_status")
}

/// Kullanıcının tenant üyeliği. Kullanıcı birden fazla tenant'a üye
/// olabilir (örn. SUPERADMIN). Üyelik aktifse o tenant'ta çalışabilir.
model UserTenantMembership {
  id         String           @id @default(uuid()) @db.Uuid
  /// Kullanıcı ID (`User.id` FK).
  userId     String           @map("user_id") @db.Uuid
  /// Ait olduğu tenant.
  tenantId   String           @map("tenant_id") @db.Uuid
  /// Kullanıcının bu tenant'taki rolü (OWNER, VETERINARIAN, STAFF).
  /// SUPERADMIN için bu tablo kullanılmaz (sistem genelinde).
  role       String           @db.VarChar(32)
  /// Üyelik durumu.
  status     MembershipStatus @default(active)
  /// Atama zamanı.
  assignedAt DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  /// Üyelik sona erme zamanı (null = aktif).
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("user_tenant_memberships")
}

// -----------------------------------------------------------------------------
// USER — Platform kullanıcısı. Personel paneli için kimlik doğrulama
// temel taşı. SUPERADMIN de bu tabloda yaşar; `memberships` üzerinden
// tenant bağlamı kazanır. Parola bcrypt ile hash'lenir (cost 12).
// -----------------------------------------------------------------------------

/// Kullanıcı hesap durumu.
enum UserStatus {
  /// Hesap aktif; giriş yapabilir.
  active
  /// Yönetici tarafından geçici olarak devre dışı.
  suspended
  /// Hesap silinmiş (soft delete; audit trail korunur).
  disabled

  @@map("user_status")
}

/// Platform kullanıcısı. Email benzersizdir; tenant bağlamı
/// `UserTenantMembership` üzerinden sağlanır. Bir kullanıcı birden
/// fazla tenant'a üye olabilir (örn. SUPERADMIN, danışman).
model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Benzersiz e-posta (giriş anahtarı). Sistem genelinde unique;
  /// tenant bazlı değil (cross-tenant davet için de aynı email
  /// kullanılabilir).
  email             String     @unique @db.VarChar(200)
  /// bcrypt parola hash (cost 12). Asla plain text loglanmaz.
  passwordHash      String     @map("password_hash") @db.VarChar(200)
  /// Hesap durumu.
  status            UserStatus @default(active)
  /// Görünen ad (operatör panelinde). PII; mask'leme uygulanır.
  displayName       String     @map("display_name") @db.VarChar(200)
  /// Kullanıcının tercih ettiği locale.
  locale            String     @default("tr-TR") @db.VarChar(10)
  /// Parolanın son değiştirilme zamanı. Eski parolaların süresi
  /// politika ile takip edilir.
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  /// Başarısız login denemesi sayacı. Brute-force koruması için.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  /// Hesap kilit bitiş zamanı. Bu tarihe kadar giriş reddedilir.
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  /// Son başarılı login zamanı.
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Hesap oluşturulma zamanı.
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Son güncelleme zamanı.
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete zamanı (kullanıcı pasif edildi; veri korunur).
  archivedAt        DateTime?  @map("archived_at") @db.Timestamptz(6)
  /// SUPERADMIN bayrağı (GOAL-012 RBAC). Sistem düzeyinde tenant
  /// dışı görünüm ve platform yönetimi için ayrıcalıklı erişim
  /// tanımlar. Tenant üyeliği olmadan çalışır. Bu bayrak yalnızca
  /// veritabanı seeder/admin tarafından set edilir; normal API'den
  /// değiştirilemez (audit iziyle birlikte GOAL-016 superadmin
  /// paneliyle yönetilecek).
  isSuperadmin      Boolean    @default(false) @map("is_superadmin")

  sessions       UserSession[]
  passwordResets PasswordResetToken[]
  memberships    UserTenantMembership[]
  uploadedFiles  FileMeta[]             @relation("FileUploader")

  @@index([status])
  @@index([lockedUntil])
  @@index([isSuperadmin])
  @@map("users")
}

// -----------------------------------------------------------------------------
// USER_SESSION — Aktif kullanıcı oturumu. Cookie tabanlı bearer token
// (sha256 hash). Süre dolunca veya `revokedAt` set edilince geçersiz
// olur. Token rotation için yeni session insert + eski revoke.
// -----------------------------------------------------------------------------

/// Kullanıcı oturumu.
model UserSession {
  id             String    @id @default(uuid()) @db.Uuid
  /// Ait olduğu kullanıcı.
  userId         String    @map("user_id") @db.Uuid
  /// SHA-256 hash'lenmiş bearer token. Plain token sadece login/logout
  /// response'unda döner; DB'de asla plain yok.
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  /// Oturumun son kullanma zamanı. Default 30 gün.
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Son kullanım zamanı (idle timeout hesabı).
  lastUsedAt     DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  /// Mask'li IP (son oktet `***`).
  ipAddress      String?   @map("ip_address") @db.VarChar(50)
  /// User agent SHA-256 hash (PII koruması).
  userAgentHash  String?   @map("user_agent_hash") @db.VarChar(64)
  /// Oluşturulma zamanı.
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Rotation sırasında set edilir: eski session'ın yerini alan session.
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  /// Manuel/logout ile sona erme zamanı.
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Revoke sebebi (logout, rotation, admin_action).
  revokedReason  String?   @map("revoked_reason") @db.VarChar(50)
  /// Aktif branch (GOAL-012 RBAC — branch scope). Login sırasında
  /// tenant'ın varsayılan branch'ı set edilir; kullanıcı daha sonra
  /// branch değiştirirse bu alan güncellenir (multi-branch tenant
  /// senaryosu). Null ise branch context yoktur (sistem düzeyi).
  activeBranchId String?   @map("active_branch_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

// -----------------------------------------------------------------------------
// USER_INVITATION — Tenant'a kullanıcı davet akışı. Davet link'i
// tek kullanımlıktır; kabul edilince User oluşturulur + membership
// atanır. Süresi 7 gün.
// -----------------------------------------------------------------------------

/// Kullanıcı davet durumu.
enum InvitationStatus {
  /// Davet gönderildi, henüz cevap yok.
  pending
  /// Davet kabul edildi, User oluşturuldu.
  accepted
  /// Davet süresi doldu.
  expired
  /// Davet iptal edildi (admin tarafından).
  cancelled

  @@map("invitation_status")
}

/// Tenant'a kullanıcı davet kaydı. Token tek kullanımlık ve süreli.
model UserInvitation {
  id         String           @id @default(uuid()) @db.Uuid
  /// Davet edilen tenant.
  tenantId   String           @map("tenant_id") @db.Uuid
  /// Davet edilen e-posta.
  email      String           @db.VarChar(200)
  /// Davet sonrası atanacak tenant rolü.
  role       String           @db.VarChar(32)
  /// SHA-256 hash'lenmiş davet token.
  tokenHash  String           @unique @map("token_hash") @db.VarChar(128)
  /// Daveti gönderen kullanıcı (audit için).
  invitedBy  String?          @map("invited_by") @db.Uuid
  /// Davet durumu.
  status     InvitationStatus @default(pending)
  /// Davet son kullanma zamanı (7 gün).
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  /// Kabul zamanı (başarılı davet).
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  /// Oluşturulma zamanı.
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId, status])
  @@index([email])
  @@index([expiresAt])
  @@map("user_invitations")
}

// -----------------------------------------------------------------------------
// PASSWORD_RESET_TOKEN — Parola sıfırlama akışı. Kullanıcı e-posta ile
// sıfırlama talep eder; token link ile gelir; tek kullanımlık ve süreli
// (1 saat). Kullanılınca veya yeni token üretilince eskiler geçersiz
/// sayılır (rotation).
// -----------------------------------------------------------------------------

/// Parola sıfırlama token'ı. Tek kullanımlık; 1 saat geçerli.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  /// Token talep eden kullanıcı.
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 hash'lenmiş token.
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  /// Token son kullanma zamanı (1 saat).
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Kullanım zamanı (null = henüz kullanılmadı).
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  /// Oluşturulma zamanı.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// AUDIT_EVENTS — Append-only audit log. Klinik ve finansal kayıt
// değişikliklerinin kanıtı. RLS ile tenant izolasyonu uygulanır.
// -----------------------------------------------------------------------------

/// Audit event kaydı. Insert-only. DB trigger'lar UPDATE/DELETE'i
/// engeller. 7 yıl retention (TR ticari kayıt gereği).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  /// Event adı (`audit:owner.create` formatında).
  eventName     String   @map("event_name") @db.VarChar(100)
  /// Tenant context. Sistem olaylarında null.
  tenantId      String?  @map("tenant_id") @db.Uuid
  /// Şube (multi-branch). Null olabilir (tenant-düzey event'ler).
  branchId      String?  @map("branch_id") @db.Uuid
  /// İşlemi yapan kullanıcı. SYSTEM/JOB event'lerde null.
  actorId       String?  @map("actor_id") @db.Uuid
  /// Aktör tipi.
  actorType     String   @map("actor_type") @db.VarChar(20)
  /// Etkilenen varlık tipi (örn. `tenant`, `branch`).
  targetType    String   @map("target_type") @db.VarChar(50)
  /// Varlık ID (string; UUID veya başka tip).
  targetId      String   @map("target_id") @db.VarChar(100)
  /// İşlem tipi (create, update, archive, vb.).
  action        String   @db.VarChar(30)
  /// Değişiklik öncesi (mask'li).
  before        Json?    @map("before")
  /// Değişiklik sonrası (mask'li).
  after         Json?    @map("after")
  /// Alan-bazlı fark.
  diff          Json?
  /// Correlation/request/job ID.
  correlationId String   @map("correlation_id") @db.VarChar(100)
  /// Mask'li IP (örn. `192.168.1.***`).
  ipAddress     String?  @map("ip_address") @db.VarChar(50)
  /// User agent SHA-256 hash (16 hex).
  userAgentHash String?  @map("user_agent_hash") @db.VarChar(64)
  /// Tenant ülkesi (TR/GB).
  country       String   @db.Char(2)
  /// Event severity.
  severity      String   @db.VarChar(10)
  /// Ek bağlam (idempotency_key, reason, vb.).
  metadata      Json?
  /// Event zamanı.
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([branchId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([eventName, createdAt])
  @@index([correlationId])
  @@index([severity, createdAt])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// FILE_META — GOAL-014 dosya ve medya servisi (metadata + audit + erişim).
// Storage (S3-uyumlu) ayrı backend'te; bu tablo yalnızca metadata + audit +
// erişim kontrolü. Fiziksel silme yerine arşivleme (archivedAt).
// -----------------------------------------------------------------------------

enum FileScanStatus {
  pending
  clean
  infected
  skipped
  error

  @@map("file_scan_status")
}

enum FileVisibility {
  private
  branch
  tenant
  portal

  @@map("file_visibility")
}

model FileMeta {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  branchId          String?        @map("branch_id") @db.Uuid
  uploaderId        String         @map("uploader_id") @db.Uuid
  storageKey        String         @unique @map("storage_key") @db.VarChar(512)
  originalName      String         @map("original_name") @db.VarChar(255)
  mimeType          String         @map("mime_type") @db.VarChar(100)
  sizeBytes         BigInt         @map("size_bytes")
  checksumSha256    String         @map("checksum_sha256") @db.VarChar(64)
  scanStatus        FileScanStatus @default(pending) @map("scan_status")
  scanResult        String?        @map("scan_result") @db.VarChar(255)
  scannedAt         DateTime?      @map("scanned_at") @db.Timestamptz(6)
  visibility        FileVisibility @default(branch)
  relatedEntityType String?        @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?        @map("related_entity_id") @db.VarChar(100)
  description       String?        @db.VarChar(500)
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  archivedBy        String?        @map("archived_by") @db.Uuid
  archiveReason     String?        @map("archive_reason") @db.VarChar(500)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploader User    @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, checksumSha256], name: "file_meta_tenant_checksum_unique")
  @@index([tenantId, createdAt])
  @@index([tenantId, relatedEntityType, relatedEntityId])
  @@index([branchId, createdAt])
  @@index([uploaderId])
  @@index([scanStatus])
  @@index([archivedAt])
  @@map("file_metas")
}

// -----------------------------------------------------------------------------
// CONTROLLED_DRUG_ENTRIES — İngiltere controlled-drug register.
// Bu tablo append-only'dir; UPDATE/DELETE database trigger'ı ile engellenir.
// -----------------------------------------------------------------------------

enum ControlledDrugEntryType {
  received
  dispensed
  wasted
  returned
  transferred
  count
  correction

  @@map("controlled_drug_entry_type")
}

enum ControlledDrugSchedule {
  S1
  S2
  S3
  S4
  S5

  @@map("controlled_drug_schedule")
}

enum ControlledDrugUnit {
  mg
  ml

  @@map("controlled_drug_unit")
}

/// İngiltere Misuse of Drugs Regulations kapsamındaki elektronik defter satırı.
/// Kayıtlar düzeltilemez veya silinemez; hata için yeni `correction` satırı eklenir.
model ControlledDrugEntry {
  id                         String                  @id @default(uuid()) @db.Uuid
  tenantId                   String                  @map("tenant_id") @db.Uuid
  entryType                  ControlledDrugEntryType @map("entry_type")
  drugName                   String                  @map("drug_name") @db.VarChar(200)
  schedule                   ControlledDrugSchedule
  unit                       ControlledDrugUnit
  quantityDelta              Decimal                 @map("quantity_delta") @db.Decimal(18, 4)
  branchId                   String                  @map("branch_id") @db.Uuid
  storageAreaId              String                  @map("storage_area_id") @db.VarChar(100)
  occurredAt                 DateTime                @map("occurred_at") @db.Timestamptz(6)
  recordedAt                 DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy                 String                  @map("recorded_by") @db.VarChar(100)
  supplier                   String?                 @db.VarChar(200)
  lotNumber                  String?                 @map("lot_number") @db.VarChar(100)
  expiryDate                 DateTime?               @map("expiry_date") @db.Date
  ownerId                    String?                 @map("owner_id") @db.VarChar(100)
  patientId                  String?                 @map("patient_id") @db.VarChar(100)
  prescribedByVeterinarianId String?                 @map("prescribed_by_veterinarian_id") @db.VarChar(100)
  prescriptionNumber         String?                 @map("prescription_number") @db.VarChar(100)
  emergencyUse               Boolean?                @map("emergency_use")
  reason                     String?                 @db.VarChar(2000)
  witnessUserId              String?                 @map("witness_user_id") @db.VarChar(100)
  targetBranchId             String?                 @map("target_branch_id") @db.Uuid
  targetStorageAreaId        String?                 @map("target_storage_area_id") @db.VarChar(100)
  transferGroupId            String?                 @map("transfer_group_id") @db.VarChar(100)
  physicalQuantity           Decimal?                @map("physical_quantity") @db.Decimal(18, 4)
  bookQuantity               Decimal?                @map("book_quantity") @db.Decimal(18, 4)
  discrepancy                Decimal?                @db.Decimal(18, 4)
  countDate                  DateTime?               @map("count_date") @db.Date
  correctsEntryId            String?                 @map("corrects_entry_id") @db.Uuid
  notes                      String?                 @db.VarChar(2000)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, occurredAt, id])
  @@index([tenantId, drugName, schedule, unit, branchId, storageAreaId, occurredAt])
  @@index([tenantId, entryType, occurredAt])
  @@index([tenantId, transferGroupId])
  @@index([tenantId, correctsEntryId])
  @@map("controlled_drug_entries")
}

// -----------------------------------------------------------------------------
// CLINIC CORE IDENTITY — tenant kapsamındaki owner ve patient kimlik kayıtları.
// Klinik/finansal olaylar bu kayıtlara referans verir; fiziksel silme yapılmaz.
// -----------------------------------------------------------------------------

model Owner {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  phone      String    @db.VarChar(32)
  email      String?   @db.VarChar(200)
  taxId      String?   @map("tax_id") @db.VarChar(20)
  address    Json?
  consents   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  patients   Patient[]

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("owners")
}

model Patient {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  name       String    @db.VarChar(100)
  species    String    @db.VarChar(20)
  breed      String?   @db.VarChar(100)
  birthDate  DateTime? @map("birth_date") @db.Date
  gender     String    @db.VarChar(20)
  microchip  String?   @db.VarChar(15)
  color      String?   @db.VarChar(100)
  neutered   Boolean
  notes      String?   @db.VarChar(2000)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, microchip])
  @@index([tenantId, ownerId, createdAt])
  @@map("patients")
}

/// Hasta sahipliği append-only geçmişidir. Aynı hasta için tek açık kayıt
/// PostgreSQL partial unique index'iyle migration seviyesinde korunur.
model OwnershipHistory {
  id        String    @id @db.VarChar(80)
  tenantId  String    @map("tenant_id") @db.Uuid
  patientId String    @map("patient_id") @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  startDate DateTime  @map("start_date") @db.Timestamptz(6)
  endDate   DateTime? @map("end_date") @db.Timestamptz(6)
  reason    String    @db.VarChar(30)
  otherNote String?   @map("other_note") @db.VarChar(1000)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, patientId, startDate])
  @@index([tenantId, ownerId, startDate])
  @@map("ownership_history")
}

/// Randevu klinik kimliğe bağlıdır; iptal/tamamlama fiziksel silme değil
/// durum geçişidir. Takvim görünümü bu kalıcı kayıttan yeniden kurulabilir.
model Appointment {
  id             String   @id @db.VarChar(80)
  tenantId       String   @map("tenant_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  veterinarianId String   @map("veterinarian_id") @db.VarChar(100)
  branchId       String?  @map("branch_id") @db.Uuid
  type           String   @db.VarChar(40)
  status         String   @db.VarChar(30)
  start          DateTime @db.Timestamptz(6)
  end            DateTime @db.Timestamptz(6)
  notes          String?  @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid

  @@index([tenantId, veterinarianId, start, end])
  @@index([tenantId, patientId, start])
  @@map("appointments")
}

/// Muayene ana kaydı; imzalı kayıtta değişiklik amendment ile izlenir.
model Examination {
  id             String    @id @db.VarChar(80)
  tenantId       String    @map("tenant_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  veterinarianId String    @map("veterinarian_id") @db.VarChar(100)
  appointmentId  String?   @map("appointment_id") @db.VarChar(80)
  status         String    @db.VarChar(30)
  type           String    @db.VarChar(40)
  chiefComplaint String    @map("chief_complaint") @db.VarChar(2000)
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  signedAt       DateTime? @map("signed_at") @db.Timestamptz(6)
  signedBy       String?   @map("signed_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, patientId, startedAt])
  @@index([tenantId, appointmentId])
  @@map("examinations")
}

model ExaminationAmend {
  id               String    @id @db.VarChar(80)
  tenantId         String    @map("tenant_id") @db.Uuid
  examinationId    String    @map("examination_id") @db.VarChar(80)
  reason           String    @db.VarChar(2000)
  amendedBy        String    @map("amended_by") @db.Uuid
  amendedAt        DateTime  @map("amended_at") @db.Timestamptz(6)
  previousSignedAt DateTime? @map("previous_signed_at") @db.Timestamptz(6)
  previousSignedBy String?   @map("previous_signed_by") @db.Uuid

  @@index([tenantId, examinationId, amendedAt])
  @@map("examination_amends")
}

model SoapNote {
  id            String    @id @db.VarChar(80)
  tenantId      String    @map("tenant_id") @db.Uuid
  examinationId String    @map("examination_id") @db.VarChar(80)
  subjective    String    @db.Text
  objective     String    @db.Text
  assessment    String    @db.Text
  plan          String    @db.Text
  status        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.Uuid
  signedAt      DateTime? @map("signed_at") @db.Timestamptz(6)
  signedBy      String?   @map("signed_by") @db.Uuid
  amendedAt     DateTime? @map("amended_at") @db.Timestamptz(6)

  @@unique([tenantId, examinationId])
  @@map("soap_notes")
}

model SoapAmend {
  id               String    @id @db.VarChar(80)
  tenantId         String    @map("tenant_id") @db.Uuid
  originalSoapId   String    @map("original_soap_id") @db.VarChar(80)
  examinationId    String    @map("examination_id") @db.VarChar(80)
  reason           String    @db.Text
  subjective       String    @db.Text
  objective        String    @db.Text
  assessment       String    @db.Text
  plan             String    @db.Text
  amendedBy        String    @map("amended_by") @db.Uuid
  amendedAt        DateTime  @map("amended_at") @db.Timestamptz(6)
  previousSignedAt DateTime? @map("previous_signed_at") @db.Timestamptz(6)
  previousSignedBy String?   @map("previous_signed_by") @db.Uuid

  @@index([tenantId, examinationId, amendedAt])
  @@map("soap_amends")
}

/// Muayene sırasında alınan vital ölçümler append-only zaman serisidir.
model VitalRecord {
  id             String   @id @db.VarChar(80)
  tenantId       String   @map("tenant_id") @db.Uuid
  examinationId  String   @map("examination_id") @db.VarChar(80)
  patientId      String   @map("patient_id") @db.Uuid
  veterinarianId String   @map("veterinarian_id") @db.VarChar(100)
  vitalSigns     Json     @map("vital_signs")
  takenAt        DateTime @map("taken_at") @db.Timestamptz(6)
  recordedBy     String   @map("recorded_by") @db.Uuid

  @@index([tenantId, examinationId, takenAt])
  @@index([tenantId, patientId, takenAt])
  @@map("vital_records")
}

model DiagnosisRecord {
  id            String    @id @db.VarChar(80)
  tenantId      String    @map("tenant_id") @db.Uuid
  examinationId String    @map("examination_id") @db.VarChar(80)
  patientId     String    @map("patient_id") @db.Uuid
  code          String?   @db.VarChar(100)
  name          String    @db.VarChar(500)
  category      String    @db.VarChar(40)
  status        String    @db.VarChar(30)
  notes         String?   @db.Text
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)

  @@index([tenantId, examinationId, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@map("diagnoses")
}

model PrescriptionRecord {
  id             String                   @id @db.VarChar(80)
  tenantId       String                   @map("tenant_id") @db.Uuid
  examinationId  String                   @map("examination_id") @db.VarChar(80)
  patientId      String                   @map("patient_id") @db.Uuid
  veterinarianId String                   @map("veterinarian_id") @db.VarChar(100)
  notes          String?                  @db.Text
  status         String                   @db.VarChar(30)
  prescribedAt   DateTime                 @map("prescribed_at") @db.Timestamptz(6)
  expiresAt      DateTime                 @map("expires_at") @db.Timestamptz(6)
  dispensedAt    DateTime?                @map("dispensed_at") @db.Timestamptz(6)
  dispensedBy    String?                  @map("dispensed_by") @db.Uuid
  cancelReason   String?                  @map("cancel_reason") @db.Text
  createdAt      DateTime                 @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @map("updated_at") @db.Timestamptz(6)
  items          PrescriptionItemRecord[]

  @@index([tenantId, patientId, prescribedAt])
  @@map("prescriptions")
}

model PrescriptionItemRecord {
  id                BigInt             @id @default(autoincrement())
  prescriptionId    String             @map("prescription_id") @db.VarChar(80)
  drugName          String             @map("drug_name") @db.VarChar(200)
  dosage            String             @db.VarChar(100)
  frequency         String             @db.VarChar(30)
  customFrequency   String?            @map("custom_frequency") @db.VarChar(200)
  durationDays      Int                @map("duration_days")
  route             String             @db.VarChar(30)
  instructions      String?            @db.Text
  productId         String?            @map("product_id") @db.VarChar(100)
  dispensedQuantity String?            @map("dispensed_quantity") @db.VarChar(30)
  dispensedLotId    String?            @map("dispensed_lot_id") @db.VarChar(100)
  prescription      PrescriptionRecord @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// -----------------------------------------------------------------------------
// INVENTORY LEDGER — Klinik reçete/tüketim ve stok hareketlerinin kalıcı,
// append-only kaynağı. Stok miktarı StockMovementRecord toplamından türetilir.
// -----------------------------------------------------------------------------

model ProductRecord {
  id                   String                @id @db.VarChar(100)
  tenantId             String                @map("tenant_id") @db.Uuid
  kind                 String                @db.VarChar(30)
  sku                  String?               @db.VarChar(100)
  barcode              String?               @db.VarChar(100)
  name                 String                @db.VarChar(300)
  category             String?               @db.VarChar(150)
  unit                 String                @db.VarChar(30)
  taxProfile           String                @map("tax_profile") @db.VarChar(30)
  purchasePrice        String?               @map("purchase_price") @db.VarChar(30)
  salePrice            String?               @map("sale_price") @db.VarChar(30)
  currency             String                @db.VarChar(10)
  clinicUsage          Boolean               @map("clinic_usage")
  petshopUsage         Boolean               @map("petshop_usage")
  saleAvailable        Boolean               @map("sale_available")
  purchaseTracked      Boolean               @map("purchase_tracked")
  vaccineProtocolId    String?               @map("vaccine_protocol_id") @db.VarChar(100)
  requiresPrescription Boolean               @map("requires_prescription")
  controlledDrug       Boolean               @map("controlled_drug")
  lowStockThreshold    String?               @map("low_stock_threshold") @db.VarChar(30)
  notes                String?               @db.Text
  active               Boolean
  createdAt            DateTime              @map("created_at") @db.Timestamptz(6)
  createdBy            String                @map("created_by") @db.VarChar(100)
  updatedAt            DateTime              @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime?             @map("archived_at") @db.Timestamptz(6)
  archivedBy           String?               @map("archived_by") @db.VarChar(100)
  archiveReason        String?               @map("archive_reason") @db.Text
  lots                 StockLotRecord[]
  movements            StockMovementRecord[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, createdAt])
  @@map("products")
}

model WarehouseRecord {
  id            String        @id @db.VarChar(100)
  tenantId      String        @map("tenant_id") @db.Uuid
  name          String        @db.VarChar(300)
  code          String        @db.VarChar(100)
  type          String        @db.VarChar(30)
  address       String?       @db.Text
  notes         String?       @db.Text
  active        Boolean
  createdAt     DateTime      @map("created_at") @db.Timestamptz(6)
  createdBy     String        @map("created_by") @db.VarChar(100)
  updatedAt     DateTime      @map("updated_at") @db.Timestamptz(6)
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(6)
  archivedBy    String?       @map("archived_by") @db.VarChar(100)
  archiveReason String?       @map("archive_reason") @db.Text
  shelves       ShelfRecord[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model ShelfRecord {
  id              String           @id @db.VarChar(100)
  tenantId        String           @map("tenant_id") @db.Uuid
  warehouseId     String           @map("warehouse_id") @db.VarChar(100)
  name            String           @db.VarChar(300)
  code            String?          @db.VarChar(100)
  temperatureZone String           @map("temperature_zone") @db.VarChar(30)
  notes           String?          @db.Text
  active          Boolean
  createdAt       DateTime         @map("created_at") @db.Timestamptz(6)
  createdBy       String           @map("created_by") @db.VarChar(100)
  updatedAt       DateTime         @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz(6)
  archivedBy      String?          @map("archived_by") @db.VarChar(100)
  archiveReason   String?          @map("archive_reason") @db.Text
  warehouse       WarehouseRecord  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lots            StockLotRecord[]

  @@unique([warehouseId, code])
  @@index([tenantId, warehouseId])
  @@map("shelves")
}

model StockLotRecord {
  id             String                @id @db.VarChar(100)
  tenantId       String                @map("tenant_id") @db.Uuid
  productId      String                @map("product_id") @db.VarChar(100)
  lotNumber      String                @map("lot_number") @db.VarChar(150)
  expiryDate     DateTime              @map("expiry_date") @db.Timestamptz(6)
  manufacturedAt DateTime?             @map("manufactured_at") @db.Timestamptz(6)
  receivedAt     DateTime              @map("received_at") @db.Timestamptz(6)
  supplierName   String?               @map("supplier_name") @db.VarChar(300)
  shelfId        String?               @map("shelf_id") @db.VarChar(100)
  quantity       String?               @db.VarChar(30)
  notes          String?               @db.Text
  active         Boolean
  createdAt      DateTime              @map("created_at") @db.Timestamptz(6)
  createdBy      String                @map("created_by") @db.VarChar(100)
  updatedAt      DateTime              @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?             @map("archived_at") @db.Timestamptz(6)
  archivedBy     String?               @map("archived_by") @db.VarChar(100)
  archiveReason  String?               @map("archive_reason") @db.Text
  product        ProductRecord         @relation(fields: [productId], references: [id], onDelete: Restrict)
  shelf          ShelfRecord?          @relation(fields: [shelfId], references: [id], onDelete: Restrict)
  movements      StockMovementRecord[]

  @@unique([productId, lotNumber])
  @@index([tenantId, productId])
  @@map("stock_lots")
}

model StockMovementRecord {
  id                 String          @id @db.VarChar(100)
  tenantId           String          @map("tenant_id") @db.Uuid
  type               String          @db.VarChar(30)
  productId          String          @map("product_id") @db.VarChar(100)
  lotId              String?         @map("lot_id") @db.VarChar(100)
  quantity           String          @db.VarChar(30)
  unitCost           String?         @map("unit_cost") @db.VarChar(30)
  unitPrice          String?         @map("unit_price") @db.VarChar(30)
  sourceType         String?         @map("source_type") @db.VarChar(80)
  sourceId           String?         @map("source_id") @db.VarChar(100)
  reversesMovementId String?         @map("reverses_movement_id") @db.VarChar(100)
  reason             String?         @db.Text
  occurredAt         DateTime        @map("occurred_at") @db.Timestamptz(6)
  notes              String?         @db.Text
  createdAt          DateTime        @map("created_at") @db.Timestamptz(6)
  createdBy          String          @map("created_by") @db.VarChar(100)
  product            ProductRecord   @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot                StockLotRecord? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, lotId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, reversesMovementId])
  @@map("stock_movements")
}

model ClinicalConsumptionRecord {
  id               String    @id @db.VarChar(100)
  tenantId         String    @map("tenant_id") @db.Uuid
  context          String    @db.VarChar(40)
  contextRefId     String    @map("context_ref_id") @db.VarChar(100)
  patientId        String?   @map("patient_id") @db.Uuid
  lines            Json
  notes            String?   @db.Text
  status           String    @db.VarChar(30)
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  createdBy        String    @map("created_by") @db.VarChar(100)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy      String?   @map("cancelled_by") @db.VarChar(100)
  cancelReason     String?   @map("cancel_reason") @db.Text
  stockMovementIds Json      @map("stock_movement_ids")

  @@index([tenantId, contextRefId, occurredAt])
  @@index([tenantId, patientId, occurredAt])
  @@map("clinical_consumptions")
}

// -----------------------------------------------------------------------------
// SUPPLIERS — Faz 6 tedarikçi kartları. Kod tenant içinde benzersizdir;
// kayıtlar geçmiş satın alma bağları için fiziksel olarak silinmez.
// -----------------------------------------------------------------------------

model SupplierRecord {
