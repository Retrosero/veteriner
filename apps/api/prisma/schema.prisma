  branchId     String?                   @map("branch_id") @db.Uuid
  status       String                    @db.VarChar(30)
  currency     String                    @db.VarChar(10)
  expectedAt   DateTime?                 @map("expected_at") @db.Timestamptz(6)
  totalAmount  String                    @map("total_amount") @db.VarChar(30)
  notes        String?                   @db.Text
  approvedAt   DateTime?                 @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?                   @map("approved_by") @db.VarChar(100)
  receivedAt   DateTime?                 @map("received_at") @db.Timestamptz(6)
  receivedBy   String?                   @map("received_by") @db.VarChar(100)
  cancelledAt  DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy  String?                   @map("cancelled_by") @db.VarChar(100)
  cancelReason String?                   @map("cancel_reason") @db.Text
  createdAt    DateTime                  @map("created_at") @db.Timestamptz(6)
  createdBy    String                    @map("created_by") @db.VarChar(100)
